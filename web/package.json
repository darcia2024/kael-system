{
  "name": "kael-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src/lib --diagnostic-level=error",
    "lint:full": "biome lint src --diagnostic-level=error",
    "test:engines": "node test-finance.js && node test-loyalty.js && node test-pos.js && tsx test-session-policy.ts && tsx test-struk.ts && tsx test-escpos.ts",
    "check": "npm run lint && npm run typecheck && npm run test:engines && npm run build",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "test:integritas": "tsx --conditions react-server test-pos-integritas.ts",
    "test:struk": "tsx test-struk.ts && tsx test-escpos.ts"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
