# Nomor WhatsApp tujuan semua CTA. Format wa.me: kode negara, tanpa "+", tanpa nol depan.
NEXT_PUBLIC_KAEL_WHATSAPP=6281311506025

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Koneksi Postgres. Port 6543 = transaction pooler (dipakai aplikasi).
# Script migrasi otomatis menukarnya ke 5432 (session pooler) karena DDL
# tidak jalan mulus di transaction mode.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Rahasia penanda tangan cookie sesi. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KAEL_AUTH_SALT=ganti-dengan-nilai-acak-minimal-16-karakter

# Google Places API. Tanpa ini, pencarian nama bisnis saat aktivasi kartu
# dimatikan dan owner diarahkan mengisi Place ID manual.
GOOGLE_PLACES_API_KEY=

# Domain publik untuk canonical, OG, sitemap, dan tautan struk.
NEXT_PUBLIC_SITE_URL=https://kaels.site

# --- Notifikasi push PWA ---
# Kabar pengembalian dana dikirim ke HP owner lewat jalur ini, bukan WhatsApp:
# mendaftarkan nomor ke WhatsApp Cloud API MENGUNCI nomor itu dari aplikasi
# WhatsApp biasa, dan nomor toko dipakai melayani pelanggan tiap hari.
#
# Buat sepasang kunci dengan:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:halo@kaels.site
