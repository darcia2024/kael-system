# Nomor WhatsApp tujuan semua CTA. Format wa.me: kode negara, tanpa "+", tanpa nol depan.
NEXT_PUBLIC_KAEL_WHATSAPP=6281311506025

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Koneksi Postgres. Port 6543 = transaction pooler (dipakai aplikasi).
# Script migrasi otomatis menukarnya ke 5432 (session pooler) karena DDL
# tidak jalan mulus di transaction mode.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Rahasia penanda tangan cookie sesi. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KAEL_AUTH_SALT=ganti-dengan-nilai-acak-minimal-16-karakter
